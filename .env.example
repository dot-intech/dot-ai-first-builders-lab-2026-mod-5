# Copiar a .env y completar con valores reales. Nunca commitear .env con valores reales.

# Cadena de conexión a PostgreSQL. Requerida: sin esta variable, src/env.ts lanza
# EnvValidationError al arrancar la app y también en `next build` (ADR-005): en CI o Docker
# basta un valor ficticio al construir.
# Ejemplo: postgresql://usuario:password@localhost:5432/nombre_db?sslmode=require
DATABASE_URL=

# Email único habilitado para el acceso directo de QA (backdoor sin magic link).
# Opcional: si no está seteada, el mecanismo de acceso QA nunca matchea ningún email.
# IMPORTANTE: NUNCA prefijarla con NEXT_PUBLIC_ — debe permanecer server-side, nunca
# expuesta en el bundle del cliente (mitigación del threat model de FEAT-001a).
QA_ACCESS_EMAIL=

# API key de Google AI Studio para analizar la foto del consumo con Gemini (ADR-009).
# Opcional: sin ella la app arranca igual; solo falla el análisis de la foto.
# IMPORTANTE: NUNCA prefijarla con NEXT_PUBLIC_ — debe permanecer server-side; expuesta en el
# bundle del cliente, cualquiera podría consumirla a nuestro costo.
# Antes de tener usuarios reales, la key debe ser de un proyecto con facturación habilitada
# (en el tier gratuito Google puede usar los datos enviados para mejorar sus productos).
# Conviene ponerle un presupuesto o una cuota en Google Cloud para acotar el gasto si se filtra
# o se abusa del endpoint.
GEMINI_API_KEY=

# --- BD de test local (docker-compose.yml) — solo para tests de integración ---
# Credenciales descartables del contenedor Postgres de test. Elegí valores propios.
TEST_DB_USER=
TEST_DB_PASSWORD=
TEST_DB_NAME=
# Puerto en loopback (127.0.0.1) donde se publica la BD de test. Default: 55432.
TEST_DB_PORT=55432
# Cadena que usan los tests de integración y drizzle-kit contra esa BD de test.
# Ejemplo: postgresql://USER:PASSWORD@localhost:55432/NAME?sslmode=disable
TEST_DATABASE_URL=
